{
  "name": "retro-games-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "Classic-inspired retro game collection",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "test:smoke": "node scripts/smoke-test.cjs"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.retrogames.arcade",
    "productName": "Retro Games Arcade",
    "asar": true,
    "files": [
      "index.html",
      "arcade-extra.js",
      "electron/**/*",
      "package.json",
      "arcade-catalog.js",
      "galaga.js",
      "arcade-polish.js",
      "classic-polish.js",
      "arcade-art.js",
      "arcade-audio.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Retro Games Arcade",
      "artifactName": "Retro-Games-Arcade-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Retro-Games-Arcade-Portable-${version}-${arch}.${ext}"
    }
  }
}
