{
  "name": "retro-games-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "Classic-inspired retro game collection",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.retrogames.arcade",
    "productName": "Retro Games Arcade",
    "asar": true,
    "files": [
      "index.html",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Retro Games Arcade"
    },
    "artifactName": "Retro-Games-Arcade-${version}-${arch}.${ext}"
  }
}
